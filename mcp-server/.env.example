# Keep the MCP bridge on loopback when using it locally.
HOST=127.0.0.1
PORT=8787

# Any OpenAI Chat Completions-compatible provider can be used.
# Examples: OpenAI, OpenRouter, or a local Ollama-compatible endpoint.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=45000

# Optional Bearer token for standalone MCP clients. In production /mcp stays disabled until set.
MCP_AUTH_TOKEN=

# Optional comma-separated browser origins allowed to open the canvas WebSocket.
# Leave empty for local development. Set this when publishing the editor.
BRIDGE_ALLOWED_ORIGINS=
